# IBM Watsonx.ai Credentials
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.

# IBM Cloud API Key (from https://cloud.ibm.com/iam/apikeys)
IBM_API_KEY=your_ibm_cloud_api_key_here

# Watsonx.ai Project ID (from your Watsonx project settings)
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Watsonx.ai URL (default for Dallas region)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Flask secret key (generate a strong random string)
FLASK_SECRET_KEY=change_this_to_a_strong_random_secret_key

# Flask environment (development | production)
FLASK_ENV=production

# Port (Render sets this automatically; override locally if needed)
PORT=5000
