# IBM Watsonx.ai Credentials
# Fill in your real values. NEVER commit this file to version control.

# IBM Cloud API Key  -> https://cloud.ibm.com/iam/apikeys
IBM_API_KEY=your_ibm_cloud_api_key_here

# Watsonx.ai Project ID  -> Watsonx project > Manage tab
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Watsonx.ai URL (Dallas region default)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Flask secret key (any long random string)
FLASK_SECRET_KEY=fitness-buddy-local-dev-secret-key-2024

# Flask environment
FLASK_ENV=development

# Port
PORT=5000